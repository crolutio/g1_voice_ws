# Python environment and caches (recreate with the setup steps in README.md)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Downloaded models (Whisper, Qwen3-TTS, Qwen3-Embedding, Piper); see "Setting up from scratch" in README.md
models/

# colcon build output and logs
build/
install/
log/

# Training: keep only the walking policies and their settings, not every checkpoint and log
# the first policy (straight knees), kept for comparison
training/logs/**
!training/logs/
!training/logs/rsl_rl/
!training/logs/rsl_rl/r1_walk_flat/
!training/logs/rsl_rl/r1_walk_flat/2026-10-26_15-04-02/
!training/logs/rsl_rl/r1_walk_flat/2026-10-26_15-04-02/model_1499.pt
!training/logs/rsl_rl/r1_walk_flat/2026-10-26_15-04-02/params/
!training/logs/rsl_rl/r1_walk_flat/2026-10-26_15-04-02/params/**
# the final policy: knee-bending walking (1500 iterations), fine-tuned to stand still on stop (750 more)
!training/logs/rsl_rl/r1_walk_flat/2026-10-28_15-31-18/
!training/logs/rsl_rl/r1_walk_flat/2026-10-28_15-31-18/model_2248.pt
!training/logs/rsl_rl/r1_walk_flat/2026-10-28_15-31-18/params/
!training/logs/rsl_rl/r1_walk_flat/2026-10-28_15-31-18/params/**
training/*.log
training/outputs/

# Robot conversion log
robots/r1/convert.log
training/imgui.ini

# YOLO-World downloads its CLIP text encoder here on first use (338 MB)
weights/
# made by training/surroundings.py on first use (the apple model and its texture)
training/assets/
